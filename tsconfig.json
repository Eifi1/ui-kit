{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // vitest's `globals: true` (see vitest.config.ts) — describe/it/expect without imports.
    // `node` for the tests that read files and spawn scripts (packaging-contract,
    // search). It used to arrive implicitly, through the vite config this file once
    // included; see the note on `include` below.
    "types": ["vitest/globals", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    // The showcase imports `@eifi1/ui-kit` exactly as a consumer does, so the code
    // beside each specimen is copy-pasteable. These must mirror showcase/alias.ts —
    // Vite resolves the page, tsc resolves the typecheck, and a path in only one of
    // them makes CI disagree with the dev server.
    "paths": {
      "@eifi1/ui-kit": ["./src/index.ts"],
      "@eifi1/ui-kit/dates": ["./src/lib/dates.ts"],
      "@eifi1/ui-kit/rhf": ["./src/rhf.ts"],
      "@eifi1/ui-kit/table-text": ["./src/table-text.ts"],
      "@eifi1/ui-kit/i18n/*": ["./src/i18n/locales/*.ts"]
    }
  },
  // The showcase is typechecked with the package, on purpose: an export deleted from
  // the barrel then becomes a compile error instead of a silently missing demo.
  // It never ships — tsup's entry is an explicit src/** glob and `files` lists only
  // dist + tokens.css.
  //
  // The build-tool configs (vite, vitest, tsup, showcase/alias.ts) are NOT here: Node
  // loads them natively, so they import with a `.ts` extension, which needs
  // `allowImportingTsExtensions` — a flag this file must not carry, because tsup's
  // declaration build reads it. They are typechecked by tsconfig.node.json instead.
  "include": ["src", "showcase/src"]
}
